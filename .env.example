# Copy to .env.local and fill in. Nothing here is committed with real values.

# Contact details shown on the site. Empty = that item is simply not rendered.
NEXT_PUBLIC_WHATSAPP_NUMBER=
NEXT_PUBLIC_PHONE_NUMBER=
NEXT_PUBLIC_WORKING_HOURS=
NEXT_PUBLIC_RESPONSE_TIME=within 24 hours on business days

# Links and analytics
NEXT_PUBLIC_PLAY_STORE_URL=
NEXT_PUBLIC_GA_MEASUREMENT_ID=
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=
NEXT_PUBLIC_BING_SITE_VERIFICATION=
NEXT_PUBLIC_SIGNUP_URL=

# Cloudflare Turnstile (site key is public, secret stays server-side)
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Lead delivery. In production at least one of these must work, otherwise the form shows an error
# and tells the visitor to use WhatsApp or email (it never pretends a lead was saved).
LEAD_WEBHOOK_URL=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
LEAD_EMAIL_FROM=
LEAD_EMAIL_TO=support@fitvario.com
